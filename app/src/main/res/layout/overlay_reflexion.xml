<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de "pensá": aparece al elegir una opción incorrecta. No se puede saltear. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🤔 Esa no es. Leé con atención"
            android:textColor="#FFC107"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRefVisual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/tvRefTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRefCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnRefOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:enabled="false"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Entendí, probar de nuevo"
            android:textSize="22sp" />

    </LinearLayout>
</ScrollView>
